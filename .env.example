# PROPERTYLENS ENVIRONMENT CONFIGURATION

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini API Key (Optional - application runs full fallback engine if unconfigured)
GEMINI_API_KEY=

# MapTiler / Mapbox Vector Tile Key (Optional - application defaults to free OSM/CartoDB tiles)
NEXT_PUBLIC_MAPTILER_KEY=

# Supabase Postgres / PostGIS (Optional - application uses local spatial JSON engine when unconfigured)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
